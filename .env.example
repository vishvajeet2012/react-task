# Local development uses /api through the Vite proxy by default.
FASTOR_PROXY_TARGET=https://staging.fastor.ai

# Vercel Preview/Production should use the same-origin Vercel rewrite.
# Set this in Vercel as: VITE_FASTOR_API_URL=/api
# If omitted, the production build calls staging.fastor.ai directly.
# VITE_FASTOR_API_URL=/api
